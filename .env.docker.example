# Copia este archivo a .env para desplegar con Docker:  cp .env.docker.example .env
APP_NAME="Control de Combustible"
APP_ENV=production
APP_DEBUG=false
# Genera la clave con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://combustible.ejemplo.gob.mx
APP_PORT=8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# El host y puerto los fija docker-compose (servicio "db")
DB_DATABASE=control_combustible
DB_USERNAME=combustible
DB_PASSWORD=cambia-esta-contraseña
DB_ROOT_PASSWORD=cambia-esta-otra

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
# true si el sitio se sirve por https (Cloudflare, proxy inverso)
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Migraciones automáticas al arrancar el contenedor app
RUN_MIGRATIONS=true
# IPs de proxies de confianza ("*" = cualquiera; Nginx siempre va delante)
TRUSTED_PROXIES=*
